{
  "name": "dosage-sync",
  "version": "1.0.0",
  "description": "用量同步（Dosage Sync）—— 多台电脑 AI 编码工具 token 用量汇总（WebDAV 同步）",
  "author": "沐辉玄",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:1420 && electron .\"",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "concurrently": "^8.2.2",
    "echarts": "^5.4.3",
    "electron": "^35.0.0",
    "electron-builder": "^24.13.3",
    "pinia": "^2.1.7",
    "typescript": "~5.3.3",
    "vite": "^4.5.3",
    "vue": "^3.4.21",
    "vue-tsc": "^1.8.27",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.dosagesync.app",
    "productName": "DosageSync",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "build/tray.png"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "用量同步"
    },
    "portable": {
      "artifactName": "DosageSync-${version}-portable.exe"
    }
  }
}
